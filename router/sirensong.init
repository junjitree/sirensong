#!/bin/sh /etc/rc.common
# procd service for sirensong on GL.iNet / OpenWrt.
#
# START=95 so it comes up after the network and after gl-repeater (which owns
# the station link it rotates). Starting earlier just means probing a link that
# does not exist yet.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/sirensong

start_service() {
	local ssid interval loglevel enabled

	config_load sirensong 2>/dev/null
	config_get_bool enabled main enabled 1
	config_get ssid main ssid "Starbucks Customer"
	config_get interval main interval 30
	config_get loglevel main loglevel "info"

	[ "$enabled" = "0" ] && return 0

	procd_open_instance
	procd_set_param command "$PROG" "$ssid" --interval "$interval"
	procd_set_param env RUST_LOG="$loglevel"
	# Unlimited retries: if it dies we want it back, and a captive portal that
	# never answers is exactly when giving up permanently is worst.
	procd_set_param respawn 3600 10 0
	# Route its output to syslog so `logread -e sirensong` works.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "sirensong"
}
